# Da copiare sul server in ~/trovacampo/.env.prod, con chmod 600.
# Vedi DEPLOY.md.

# Utente e password di root di MongoDB. Valgono solo alla prima accensione,
# quando il volume e' vuoto: cambiarli dopo non cambia l'utente nel database.
#
# La password finisce dentro un URI mongodb://utente:password@..., quindi
# niente caratteri che in un URI hanno un significato (@ : / ? # %).
# Generala con:  openssl rand -hex 24
MONGO_USER=trovacampo
MONGO_PASSWORD=

# Scritta dal workflow a ogni rilascio: il tag delle immagini in esecuzione.
# TAG_IMMAGINI=
